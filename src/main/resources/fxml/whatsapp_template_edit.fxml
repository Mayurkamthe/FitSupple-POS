<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.WhatsAppTemplateEditController"
      spacing="10" style="-fx-padding: 24;">

    <Label fx:id="headerLabel" text="Add Template" styleClass="login-title"/>
    <Label text="Enter the exact template name and language approved in Meta Business Manager." styleClass="placeholder-text" wrapText="true"/>

    <Label text="Template Name *"/>
    <TextField fx:id="nameField"/>

    <Label text="Language Code (e.g. en, en_US, hi)"/>
    <TextField fx:id="languageField" text="en"/>

    <Label text="Category (MARKETING / UTILITY / AUTHENTICATION)"/>
    <TextField fx:id="categoryField"/>

    <Label text="Body Text (for reference only — must match the approved template)"/>
    <TextArea fx:id="bodyField" prefRowCount="3"/>

    <Label text="Number of {{n}} Placeholders"/>
    <TextField fx:id="placeholderCountField" text="0"/>

    <CheckBox fx:id="activeCheckBox" text="Active" selected="true"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button text="Save Template" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
