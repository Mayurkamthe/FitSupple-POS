<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.StockAdjustController"
      spacing="12" styleClass="root">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label fx:id="titleLabel" text="Adjust Stock" styleClass="login-title"/>
    <Label fx:id="batchInfoLabel" styleClass="placeholder-text" wrapText="true"/>

    <Label text="Adjustment Type"/>
    <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>

    <Label text="Quantity (use a positive number; DAMAGE/EXPIRED always reduce stock)"/>
    <TextField fx:id="quantityField" promptText="e.g. 5"/>

    <Label text="Reason / Notes"/>
    <TextArea fx:id="reasonField" prefRowCount="3" wrapText="true"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button text="Save Adjustment" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
