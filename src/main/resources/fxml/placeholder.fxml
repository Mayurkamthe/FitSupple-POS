<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.PlaceholderController"
      spacing="10" styleClass="card" maxWidth="600">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    <Label fx:id="titleLabel" styleClass="placeholder-title"/>
    <Label fx:id="messageLabel" styleClass="placeholder-text" wrapText="true"/>
</VBox>
