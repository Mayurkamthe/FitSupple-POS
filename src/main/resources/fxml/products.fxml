<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.ProductController"
      spacing="16">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Products" styleClass="placeholder-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by name, SKU or barcode..." prefWidth="280" onKeyReleased="#handleSearch"/>
        <Button text="+ Add Product" styleClass="btn-primary" onAction="#handleAddProduct"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS" prefHeight="560">
        <columns>
            <TableColumn fx:id="nameCol" text="Product Name" prefWidth="220"/>
            <TableColumn fx:id="categoryCol" text="Category" prefWidth="130"/>
            <TableColumn fx:id="brandCol" text="Brand" prefWidth="110"/>
            <TableColumn fx:id="skuCol" text="SKU" prefWidth="100"/>
            <TableColumn fx:id="barcodeCol" text="Barcode" prefWidth="110"/>
            <TableColumn fx:id="mrpCol" text="MRP" prefWidth="80"/>
            <TableColumn fx:id="sellingPriceCol" text="Selling Price" prefWidth="100"/>
            <TableColumn fx:id="stockCol" text="Stock" prefWidth="70"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="110"/>
            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
