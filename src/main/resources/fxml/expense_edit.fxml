<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.ExpenseEditController"
      spacing="10" style="-fx-padding: 24;">

    <Label fx:id="headerLabel" text="Add Expense" styleClass="login-title"/>

    <Label text="Category *"/>
    <ComboBox fx:id="categoryCombo" maxWidth="Infinity"/>

    <Label text="Amount *"/>
    <TextField fx:id="amountField"/>

    <Label text="Date *"/>
    <DatePicker fx:id="datePicker" maxWidth="Infinity"/>

    <Label text="Notes"/>
    <TextArea fx:id="notesField" prefRowCount="3"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button text="Save Expense" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
