<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.ExpenseController"
      spacing="16">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Expenses" styleClass="placeholder-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="From"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="To"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button text="Filter" styleClass="btn-secondary" onAction="#handleFilter"/>
        <Button text="Show All" styleClass="btn-secondary" onAction="#handleShowAll"/>
        <Button text="+ Add Expense" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <Label fx:id="totalLabel" text="Total: ₹0.00" styleClass="card-value"/>

    <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS" prefHeight="560">
        <columns>
            <TableColumn fx:id="dateCol" text="Date" prefWidth="130"/>
            <TableColumn fx:id="categoryCol" text="Category" prefWidth="140"/>
            <TableColumn fx:id="amountCol" text="Amount" prefWidth="110"/>
            <TableColumn fx:id="notesCol" text="Notes" prefWidth="300"/>
            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
