<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.SettingsController"
      spacing="16">

    <Label text="Settings" styleClass="placeholder-title"/>

    <VBox styleClass="card" spacing="12">
        <Label text="Shop &amp; Invoice Settings" styleClass="card-title"/>

        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Shop Name *"/>
                <TextField fx:id="shopNameField"/>
            </VBox>
            <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Phone"/>
                <TextField fx:id="phoneField"/>
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Email"/>
                <TextField fx:id="emailField"/>
            </VBox>
            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="Logo File Path (optional)"/>
                <TextField fx:id="logoPathField"/>
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="0">
                <Label text="Invoice Number Prefix"/>
                <TextField fx:id="invoicePrefixField"/>
            </VBox>
            <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <Label text="Purchase Number Prefix"/>
                <TextField fx:id="purchasePrefixField"/>
            </VBox>
        </GridPane>

        <Label text="Address"/>
        <TextArea fx:id="addressField" prefRowCount="2"/>

        <Label text="Invoice Footer Note"/>
        <TextArea fx:id="footerNoteField" prefRowCount="2"/>

        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Save Settings" styleClass="btn-primary" onAction="#handleSave"/>
        </HBox>
    </VBox>

    <VBox styleClass="card" spacing="8">
        <Label text="Security" styleClass="card-title"/>
        <Label text="Owner password can be changed from the header menu (top-right of the app) at any time." styleClass="placeholder-text" wrapText="true"/>
    </VBox>

    <VBox styleClass="card" spacing="8">
        <Label text="WhatsApp Cloud API Configuration" styleClass="card-title"/>
        <Label text="WhatsApp access tokens and phone number IDs are never stored in the app database or source code. Edit them directly in the external config file below, then restart the app." styleClass="placeholder-text" wrapText="true"/>
        <Label fx:id="configPathLabel" styleClass="placeholder-text" wrapText="true"/>
    </VBox>

    <VBox styleClass="card" spacing="8">
        <Label text="Data Locations" styleClass="card-title"/>
        <Label fx:id="dataDirLabel" styleClass="placeholder-text" wrapText="true"/>
        <Label fx:id="backupDirLabel" styleClass="placeholder-text" wrapText="true"/>
        <Label fx:id="logDirLabel" styleClass="placeholder-text" wrapText="true"/>
    </VBox>
</VBox>
