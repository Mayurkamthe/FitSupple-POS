<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.CustomerController"
      spacing="16">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Customers" styleClass="placeholder-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by name or mobile..." prefWidth="260" onKeyReleased="#handleSearch"/>
        <Button text="+ Add Customer" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" prefHeight="600">
        <columns>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="160"/>
            <TableColumn fx:id="mobileCol" text="Mobile" prefWidth="120"/>
            <TableColumn fx:id="segmentCol" text="Segment" prefWidth="110"/>
            <TableColumn fx:id="ordersCol" text="Orders" prefWidth="70"/>
            <TableColumn fx:id="spendingCol" text="Total Spending" prefWidth="120"/>
            <TableColumn fx:id="lastPurchaseCol" text="Last Purchase" prefWidth="150"/>
            <TableColumn fx:id="favouriteCol" text="Favourite Product" prefWidth="160"/>
            <TableColumn fx:id="whatsappCol" text="WhatsApp Opt-in" prefWidth="120"/>
            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
