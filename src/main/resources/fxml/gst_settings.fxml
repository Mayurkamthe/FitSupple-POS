<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.GstSettingController"
      spacing="16">

    <Label text="GST / Non-GST Billing" styleClass="placeholder-title"/>

    <VBox styleClass="card" spacing="14" maxWidth="560">
        <Label text="Billing Mode" styleClass="card-title"/>
        <HBox spacing="20">
            <fx:define>
                <ToggleGroup fx:id="modeGroup"/>
            </fx:define>
            <RadioButton fx:id="gstRadio" text="GST Registered" toggleGroup="$modeGroup"/>
            <RadioButton fx:id="nonGstRadio" text="Non-GST" toggleGroup="$modeGroup"/>
        </HBox>

        <Label text="When GST Registered is selected, POS Billing calculates CGST + SGST on every sale (intra-state assumed) and product GST rates apply. When Non-GST is selected, bills are plain retail bills with no tax line." styleClass="placeholder-text" wrapText="true"/>

        <Label text="GSTIN"/>
        <TextField fx:id="gstinField" promptText="e.g. 27ABCDE1234F1Z5"/>

        <Label text="State Code (for CGST/SGST vs IGST — 2 digits)"/>
        <TextField fx:id="stateCodeField" promptText="e.g. 27"/>

        <Label text="Default GST Rate (%) — used for products without their own rate set"/>
        <TextField fx:id="defaultGstRateField"/>

        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>
        <Label fx:id="successLabel" styleClass="placeholder-text" managed="false" visible="false"/>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Save Settings" styleClass="btn-primary" onAction="#handleSave"/>
        </HBox>
    </VBox>
</VBox>
