<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.PurchaseReturnController"
      spacing="16">

    <Label text="Purchase Returns" styleClass="placeholder-title"/>

    <VBox styleClass="card" spacing="10">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Purchase Invoice Number"/>
            <TextField fx:id="invoiceField" promptText="e.g. PUR-000001" prefWidth="220" onAction="#handleSearchInvoice"/>
            <Button text="Search" styleClass="btn-secondary" onAction="#handleSearchInvoice"/>
        </HBox>
        <Label fx:id="purchaseInfoLabel" styleClass="placeholder-text"/>
        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <TableView fx:id="itemsTable" prefHeight="260">
        <columns>
            <TableColumn fx:id="itemProductCol" text="Product" prefWidth="200"/>
            <TableColumn fx:id="itemBatchCol" text="Batch" prefWidth="90"/>
            <TableColumn fx:id="itemQtyCol" text="Qty Received" prefWidth="100"/>
            <TableColumn fx:id="itemReturnedCol" text="Already Returned" prefWidth="120"/>
            <TableColumn fx:id="itemReturnableCol" text="Returnable" prefWidth="90"/>
            <TableColumn fx:id="itemTotalCol" text="Line Total" prefWidth="100"/>
        </columns>
    </TableView>

    <VBox styleClass="card" spacing="10">
        <Label text="Process Return" styleClass="card-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Return Qty"/>
            <TextField fx:id="returnQtyField" prefWidth="80"/>
            <Label text="Reason"/>
            <TextField fx:id="reasonField" prefWidth="220" promptText="e.g. Damaged in transit"/>
            <Button text="Process Return" styleClass="btn-accent" onAction="#handleProcessReturn"/>
        </HBox>
    </VBox>

    <VBox styleClass="card" spacing="8">
        <Label text="Recent Purchase Returns" styleClass="card-title"/>
        <TableView fx:id="recentReturnsTable" prefHeight="200">
            <columns>
                <TableColumn fx:id="recentDateCol" text="Date" prefWidth="140"/>
                <TableColumn fx:id="recentInvoiceCol" text="Purchase Invoice" prefWidth="140"/>
                <TableColumn fx:id="recentProductCol" text="Product" prefWidth="180"/>
                <TableColumn fx:id="recentQtyCol" text="Qty" prefWidth="60"/>
                <TableColumn fx:id="recentReasonCol" text="Reason" prefWidth="160"/>
                <TableColumn fx:id="recentRefundCol" text="Refund" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
