<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.SupplierEditController"
      spacing="10" style="-fx-padding: 24;">

    <Label fx:id="headerLabel" text="Add Supplier" styleClass="login-title"/>

    <Label text="Name *"/>
    <TextField fx:id="nameField"/>

    <Label text="Contact Person"/>
    <TextField fx:id="contactPersonField"/>

    <Label text="Phone"/>
    <TextField fx:id="phoneField"/>

    <Label text="Email"/>
    <TextField fx:id="emailField"/>

    <Label text="GSTIN"/>
    <TextField fx:id="gstinField"/>

    <Label text="Address"/>
    <TextArea fx:id="addressField" prefRowCount="2"/>

    <Label text="Notes"/>
    <TextArea fx:id="notesField" prefRowCount="2"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button text="Save Supplier" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
