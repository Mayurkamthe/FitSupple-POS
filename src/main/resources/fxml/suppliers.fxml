<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.SupplierController"
      spacing="16">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Suppliers" styleClass="placeholder-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search suppliers..." prefWidth="260" onKeyReleased="#handleSearch"/>
        <Button text="+ Add Supplier" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="supplierTable" VBox.vgrow="ALWAYS" prefHeight="560">
        <columns>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="200"/>
            <TableColumn fx:id="contactCol" text="Contact Person" prefWidth="160"/>
            <TableColumn fx:id="phoneCol" text="Phone" prefWidth="120"/>
            <TableColumn fx:id="emailCol" text="Email" prefWidth="180"/>
            <TableColumn fx:id="gstinCol" text="GSTIN" prefWidth="140"/>
            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
