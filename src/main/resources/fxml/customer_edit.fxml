<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.CustomerEditController"
      spacing="10" style="-fx-padding: 24;">

    <Label fx:id="headerLabel" text="Add Customer" styleClass="login-title"/>

    <Label text="Name *"/>
    <TextField fx:id="nameField"/>

    <Label text="Mobile *"/>
    <TextField fx:id="mobileField"/>

    <Label text="WhatsApp Number"/>
    <TextField fx:id="whatsappField"/>

    <Label text="Email"/>
    <TextField fx:id="emailField"/>

    <Label text="Birthday"/>
    <DatePicker fx:id="birthdayPicker" maxWidth="Infinity"/>

    <Label text="Address"/>
    <TextArea fx:id="addressField" prefRowCount="2"/>

    <Label text="Notes"/>
    <TextArea fx:id="notesField" prefRowCount="2"/>

    <CheckBox fx:id="whatsappOptInCheckBox" text="Opted in to WhatsApp messages" selected="true"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button text="Save Customer" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
