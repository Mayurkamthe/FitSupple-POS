<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitsupplepos.controller.BarcodePreviewController"
      spacing="14" alignment="CENTER" style="-fx-padding: 24;">

    <Label fx:id="productNameLabel" styleClass="login-title"/>
    <ImageView fx:id="barcodeImageView" fitWidth="280" fitHeight="90" preserveRatio="true"/>
    <Label fx:id="codeLabel" styleClass="placeholder-text"/>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Copies per label sheet:"/>
        <TextField fx:id="copiesField" text="12" prefWidth="60"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Close" styleClass="btn-secondary" onAction="#handleClose"/>
        <Button text="Save Label Sheet PDF" styleClass="btn-primary" onAction="#handleSaveLabelSheet"/>
    </HBox>
</VBox>
